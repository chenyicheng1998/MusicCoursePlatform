<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.StudentDashboardController"
            stylesheets="@../css/styles.css"
            prefHeight="700.0" prefWidth="1000.0">
    
    <!-- Top Navbar -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <Label text="MusicCoursePlatform" styleClass="navbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="languageCombo" promptText="EN" prefWidth="80"/>
            <Circle fx:id="avatarCircle" radius="20" style="-fx-fill: #E2E8F0;"/>
            <Circle radius="6" style="-fx-fill: #E53E3E;"/>
        </HBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <HBox style="-fx-background-color: #F5F5F5;" spacing="0">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            
            <!-- Main Card -->
            <VBox styleClass="card" spacing="20" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
                
                <HBox spacing="30" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                    <!-- Left Panel - Teacher Selection -->
                    <VBox spacing="16" prefWidth="250">
                        <!-- Avatar and Name -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Circle radius="25" style="-fx-fill: #CBD5E0;"/>
                            <Label fx:id="teacherNameLabel" text="Name" styleClass="teacher-name"/>
                        </HBox>
                        
                        <!-- Instrument Dropdown -->
                        <ComboBox fx:id="instrumentCombo" 
                                  promptText="Piano" 
                                  prefWidth="220"
                                  onAction="#handleInstrumentChange"/>
                        
                        <!-- Teacher Dropdown -->
                        <ComboBox fx:id="teacherCombo" 
                                  promptText="Select Teacher" 
                                  prefWidth="220"
                                  onAction="#handleTeacherChange"/>
                        
                        <!-- Teacher's Profile Link -->
                        <Button text="Teacher's Profile" 
                                styleClass="secondary-button"
                                onAction="#handleViewProfile"
                                prefWidth="220"/>
                    </VBox>
                    
                    <!-- Center Panel - Calendar -->
                    <VBox spacing="16" alignment="TOP_CENTER">
                        <Label text="Frame" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px;"/>
                        
                        <!-- Month Navigation -->
                        <HBox alignment="CENTER" spacing="12">
                            <Button fx:id="prevMonthBtn" text="‹" styleClass="back-button" onAction="#handlePrevMonth"/>
                            <Label fx:id="monthLabel" text="September 2026" styleClass="calendar-header"/>
                            <Button fx:id="nextMonthBtn" text="›" styleClass="back-button" onAction="#handleNextMonth"/>
                        </HBox>
                        
                        <!-- Calendar Grid -->
                        <VBox fx:id="calendarContainer" spacing="8" alignment="CENTER">
                            <!-- Day headers -->
                            <HBox spacing="8" alignment="CENTER">
                                <Label text="So." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Mo." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Di." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Mi." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Do." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Fr." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                                <Label text="Sa." prefWidth="40" style="-fx-text-fill: #718096; -fx-alignment: CENTER;"/>
                            </HBox>
                            <!-- Calendar days will be populated dynamically -->
                            <FlowPane fx:id="calendarGrid" hgap="8" vgap="8" prefWidth="336"/>
                        </VBox>
                    </VBox>
                    
                    <!-- Right Panel - Time Slots / View Schedule -->
                    <VBox spacing="16" prefWidth="200">
                        <Label text="View Schedule" styleClass="section-title"/>
                        
                        <Label fx:id="selectedDateLabel" text="Select a date" style="-fx-text-fill: #718096;"/>
                        
                        <ScrollPane fitToWidth="true" prefHeight="300" style="-fx-background-color: transparent;">
                            <VBox fx:id="timeSlotsContainer" spacing="10">
                                <!-- Time slots will be populated dynamically -->
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </center>
    
    <!-- Bottom Navigation -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #F5F5F5; -fx-padding: 20;">
            <Button text="‹" styleClass="back-button" onAction="#handlePrevPage"/>
            <Button text="›" styleClass="back-button" onAction="#handleNextPage"/>
        </HBox>
    </bottom>
</BorderPane>
