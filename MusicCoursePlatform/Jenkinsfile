pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        // Add Docker to PATH for Windows
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;C:\\Tools\\apache-jmeter-5.6.3\\bin;${env.PATH}"

        // Docker Hub credentials (you need to configure this in Jenkins)
        DOCKERHUB_CREDENTIALS_ID = 'Docker_Hub'
        DOCKERHUB_REPO = 'chenyicheng1998/music-course-platform'
        DOCKER_IMAGE_TAG = 'latest'

        // Database configuration
        DB_NAME = 'music_course_platform'

        // SonarQube configuration (Sprint 7)
        SONAR_HOST_URL = 'http://localhost:9000'
        SONAR_PROJECT_KEY = 'music-course-platform'

        // JMeter configuration (Sprint 7)
        JMETER_HOME = 'C:\\Tools\\apache-jmeter-5.6.3'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
                git branch: 'main',
                    url: 'https://github.com/chenyicheng1998/MusicCoursePlatform.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building project with Maven...'
                dir('MusicCoursePlatform') {
                    bat 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running unit tests...'
                dir('MusicCoursePlatform') {
                    bat 'mvn test'
                }
            }
            post {
                always {
                    // Publish test results
                    junit 'MusicCoursePlatform/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube static code analysis...'
                dir('MusicCoursePlatform') {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        bat """
                            mvn sonar:sonar ^
                                -Dsonar.projectKey=%SONAR_PROJECT_KEY% ^
                                -Dsonar.host.url=%SONAR_HOST_URL% ^
                                -Dsonar.token=%SONAR_TOKEN% ^
                                -Dsonar.java.binaries=target/classes ^
                                -Dsonar.java.test.binaries=target/test-classes ^
                                -Dsonar.sources=src/main/java ^
                                -Dsonar.tests=src/test/java
                        """
                    }
                }
            }
            post {
                success {
                    echo "SonarQube analysis complete. View results at ${SONAR_HOST_URL}/dashboard?id=${SONAR_PROJECT_KEY}"
                }
                failure {
                    echo 'SonarQube analysis failed. Check that SonarQube is running at localhost:9000 and the token is valid.'
                }
            }
        }

        stage('Generate JaCoCo Report') {
            steps {
                echo 'Generating code coverage report...'
                dir('MusicCoursePlatform') {
                    bat 'mvn jacoco:report'
                }
            }
            post {
                always {
                    // Publish coverage report
                    jacoco(
                        execPattern: 'MusicCoursePlatform/target/jacoco.exec',
                        classPattern: 'MusicCoursePlatform/target/classes',
                        sourcePattern: 'MusicCoursePlatform/src/main/java'
                    )
                }
            }
        }

        stage('Non-Functional Test (JMeter)') {
            steps {
                echo 'Running JMeter performance tests against MariaDB...'
                dir('MusicCoursePlatform') {
                    bat 'jmeter -n -t tests/performance/musiccourse.jmx -l result.jtl'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'MusicCoursePlatform/result.jtl', allowEmptyArchive: true
                    perfReport sourceDataFiles: 'MusicCoursePlatform/result.jtl'
                }
            }
        }

        stage('Package Application') {
            steps {
                echo 'Packaging application...'
                dir('MusicCoursePlatform') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo 'Archiving JAR file...'
                archiveArtifacts artifacts: 'MusicCoursePlatform/target/*.jar',
                                fingerprint: true,
                                allowEmptyArchive: true
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image with --no-cache to ensure Chinese fonts are properly installed...'
                dir('MusicCoursePlatform') {
                    script {
                        bat "docker build --no-cache -t ${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG} ."
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS_ID) {
                        docker.image("${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}").push()
                    }
                }
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
            echo "Docker image pushed: ${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}"
        }

        failure {
            echo '❌ Pipeline failed!'
        }

        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
    }
}

