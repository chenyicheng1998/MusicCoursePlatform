pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        // Add Docker to PATH for Windows
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"

        // Docker Hub credentials (you need to configure this in Jenkins)
        DOCKERHUB_CREDENTIALS_ID = 'Docker_Hub'
        DOCKERHUB_REPO = 'chenyicheng1998/music-course-platform'
        DOCKER_IMAGE_TAG = 'latest'

        // Database configuration
        DB_NAME = 'music_course_platform'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
                git branch: 'main',
                    url: 'https://github.com/chenyicheng1998/MusicCoursePlatform.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building project with Maven...'
                dir('MusicCoursePlatform') {
                    bat 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running unit tests...'
                dir('MusicCoursePlatform') {
                    bat 'mvn test'
                }
            }
            post {
                always {
                    // Publish test results
                    junit 'MusicCoursePlatform/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Generate JaCoCo Report') {
            steps {
                echo 'Generating code coverage report...'
                dir('MusicCoursePlatform') {
                    bat 'mvn jacoco:report'
                }
            }
            post {
                always {
                    // Publish coverage report
                    jacoco(
                        execPattern: 'MusicCoursePlatform/target/jacoco.exec',
                        classPattern: 'MusicCoursePlatform/target/classes',
                        sourcePattern: 'MusicCoursePlatform/src/main/java'
                    )
                }
            }
        }

        stage('Package Application') {
            steps {
                echo 'Packaging application...'
                dir('MusicCoursePlatform') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo 'Archiving JAR file...'
                archiveArtifacts artifacts: 'MusicCoursePlatform/target/*.jar',
                                fingerprint: true,
                                allowEmptyArchive: true
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image with --no-cache to ensure Chinese fonts are properly installed...'
                dir('MusicCoursePlatform') {
                    script {
                        bat "docker build --no-cache -t ${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG} ."
                    }
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS_ID) {
                        docker.image("${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}").push()
                    }
                }
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
            echo "Docker image pushed: ${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}"
        }

        failure {
            echo '❌ Pipeline failed!'
        }

        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
    }
}

